#!/usr/bin/env bash
# User-local Spotify with the XeruxBlack Spicetify theme.
set -e
spotify_config="${XDG_CONFIG_HOME:-$HOME/.config}"
spotify_flags=()
if [[ -f "$spotify_config/spotify-flags.conf" ]]; then
    mapfile -t spotify_flags < <(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$spotify_config/spotify-flags.conf")
fi
exec "$HOME/.local/share/spotify/spotify" "${spotify_flags[@]}" "$@"
