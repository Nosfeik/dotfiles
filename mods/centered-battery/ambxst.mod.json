{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/main/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "local.centered-battery",
  "name": "Centered Battery",
  "version": "1.2.3",
  "description": "Batería horizontal gruesa con núcleo continuo en una cápsula temática; conserva el popup y los perfiles originales.",
  "author": "nosfeik (implementación asistida por Codex)",
  "license": "UNLICENSED",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.14 <1.3.15",
    "testedBaseCommits": [
      "83e8462a6b03d4a7d428d5c7365e4ec03f3b63a9"
    ]
  },
  "localization": {
    "mode": "none"
  },
  "dependencies": [],
  "conflicts": [
    "local.battery-indicator"
  ],
  "commands": [],
  "permissions": [
    "Reads the existing Ambxst Battery service; preserves the original power-profile controls"
  ],
  "operations": [
    {
      "type": "overlay",
      "source": "payload/modules/bar/CenteredBatteryGraphic.qml",
      "target": "modules/bar/CenteredBatteryGraphic.qml"
    },
    {
      "type": "patch",
      "source": "patches/centered-battery.patch"
    }
  ]
}
