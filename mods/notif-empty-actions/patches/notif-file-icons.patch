+                            source: (notificationGroup && notificationGroup.appIcon !== "") ? (notificationGroup.appIcon.startsWith("/") ? "file://" + notificationGroup.appIcon : (/^(file|data|https?|image|qrc):/.test(notificationGroup.appIcon) ? notificationGroup.appIcon : "image://icon/" + notificationGroup.appIcon)) : ""
                             fillMode: Image.PreserveAspectFit
